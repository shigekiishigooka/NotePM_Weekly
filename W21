  th { background: var(--gray-50); padding: 7px 10px; text-align: left; font-weight: 600; color: var(--gray-600); border-bottom: 2px solid var(--gray-200); white-space: nowrap; }
  td { padding: 7px 10px; border-bottom: 1px solid var(--gray-100); vertical-align: middle; }
  tr:last-child td { border-bottom: none; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .bold { font-weight: 700; }
  .sub-row td { color: var(--gray-400); font-size: 12px; padding-left: 20px; }
  .avg-col { background: #fafaf0; }
  .dn  { display: inline-block; background: var(--red-light);   color: var(--red);   font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 99px; white-space: nowrap; }
  .up  { display: inline-block; background: var(--green-light); color: var(--green); font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 99px; white-space: nowrap; }
  .nt  { display: inline-block; background: var(--gray-100);    color: var(--gray-600); font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 99px; white-space: nowrap; }
  .gw  { display: inline-block; background: #fff3cd; color: #856404; font-size: 10px; font-weight: 600; padding: 1px 5px; border-radius: 3px; margin-left: 4px; }
  .gauge-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; }
  .gauge-track { flex: 1; height: 7px; background: var(--gray-200); border-radius: 4px; overflow: hidden; }
  .gauge-fill { height: 100%; border-radius: 4px; }
  .gauge-label { font-size: 12px; font-weight: 700; min-width: 44px; text-align: right; }
  .kpi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .kpi-box { background: var(--gray-50); border-radius: 8px; padding: 12px 14px; }
  .kpi-label { font-size: 11px; color: var(--gray-600); }
  .kpi-value { font-size: 24px; font-weight: 800; margin: 2px 0 1px; }
  .kpi-sub { font-size: 11px; color: var(--gray-600); }
  .alert { background: #fefce8; border: 1px solid #fcd34d; border-radius: 7px; padding: 8px 12px; font-size: 12px; color: #92400e; margin-bottom: 14px; }
  .col2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .col-title { font-size: 12px; font-weight: 700; color: var(--gray-600); margin-bottom: 8px; }
  .rank-row { display: flex; align-items: flex-start; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--gray-100); }
  .rank-row:last-child { border-bottom: none; }
  .rank-num { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0; margin-top: 1px; }
  .r1 { background: var(--amber); } .r2 { background: var(--gray-400); } .r3 { background: #cd7c3b; } .rn { background: var(--blue); }
  .rank-body { flex: 1; min-width: 0; }
  .rank-cat { font-size: 10px; color: var(--blue); background: var(--blue-light); display: inline-block; padding: 0 5px; border-radius: 3px; margin-bottom: 2px; }
  .rank-title { font-size: 12px; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rank-val { font-weight: 700; font-size: 13px; white-space: nowrap; margin-left: 6px; flex-shrink: 0; }
  .insight { border-left: 4px solid var(--blue); background: var(--blue-light); border-radius: 0 7px 7px 0; padding: 10px 14px; margin-bottom: 10px; }
  .insight:last-child { margin-bottom: 0; }
  .insight-head { font-weight: 700; font-size: 13px; margin-bottom: 6px; }
  .insight p { font-size: 13px; margin-bottom: 5px; }
  .insight p:last-child { margin-bottom: 0; }
  .tag-f { font-weight: 700; color: var(--blue); margin-right: 4px; }
