  .summary-box { background: var(--gray-50); border-radius: 7px; padding: 10px 14px; margin-bottom: 14px; font-size: 13px; font-weight: 600; }
  .src { font-size: 10px; color: var(--gray-400); text-align: right; margin-top: 10px; }
  .note { font-size: 11px; color: var(--gray-600); margin-top: 8px; background: var(--gray-50); padding: 6px 10px; border-radius: 5px; }
